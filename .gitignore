# virtualenv + caches (keep off C: drive, keep out of git)
.venv/
.uv-cache/
.cache/
__pycache__/
*.pyc
.pytest_cache/

# the portable brain — synced encrypted via exo sync, never via git
/state/

# real config holds secrets; config.example.yaml is the committed template
config.yaml

# build artifacts
dist/
*.egg-info/

# machine-specific launchers generated by `exo install` (absolute paths)
/ops/
